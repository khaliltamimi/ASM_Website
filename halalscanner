<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>حلال — Halal Scanner</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/quagga/0.12.1/quagga.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0f0a;
    --surface: #111811;
    --surface2: #162016;
    --green: #3ddc6e;
    --green-dim: #1a4a2a;
    --red: #e84040;
    --red-dim: #4a1a1a;
    --amber: #f0a500;
    --amber-dim: #3a2800;
    --text: #d4e8d4;
    --text-dim: #5a7a5a;
    --border: #1e321e;
    --scan-line: rgba(61, 220, 110, 0.6);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Mono', monospace;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow-x: hidden;
  }

  /* Noise texture overlay */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 1000;
    opacity: 0.5;
  }

  header {
    width: 100%;
    max-width: 480px;
    padding: 28px 24px 16px;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .logo-arabic {
    font-family: 'Amiri', serif;
    font-size: 2.2rem;
    color: var(--green);
    line-height: 1;
    text-shadow: 0 0 30px rgba(61,220,110,0.4);
  }

  .logo-sub {
    font-size: 0.65rem;
    color: var(--text-dim);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .main {
    width: 100%;
    max-width: 480px;
    padding: 0 16px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Camera viewport */
  .scanner-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    border: 1px solid var(--border);
  }

  #scanner-viewport {
    width: 100%;
    height: 100%;
  }

  #scanner-viewport video,
  #scanner-viewport canvas {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
  }

  /* Corner frame decorations */
  .corner {
    position: absolute;
    width: 28px;
    height: 28px;
    border-color: var(--green);
    border-style: solid;
    z-index: 10;
    transition: opacity 0.3s;
  }
  .corner-tl { top: 12px; left: 12px; border-width: 2px 0 0 2px; }
  .corner-tr { top: 12px; right: 12px; border-width: 2px 2px 0 0; }
  .corner-bl { bottom: 12px; left: 12px; border-width: 0 0 2px 2px; }
  .corner-br { bottom: 12px; right: 12px; border-width: 0 2px 2px 0; }

  /* Animated scan line */
  .scan-line {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--scan-line), transparent);
    z-index: 10;
    animation: scanMove 2.5s ease-in-out infinite;
    box-shadow: 0 0 12px var(--green);
  }
  @keyframes scanMove {
    0%, 100% { top: 20%; }
    50% { top: 80%; }
  }

  .scan-idle-text {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    font-size: 0.7rem;
    color: var(--text-dim);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-align: center;
    padding: 20px;
    pointer-events: none;
  }

  /* Manual barcode input */
  .manual-section {
    display: flex;
    gap: 8px;
  }

  input[type="text"] {
    flex: 1;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 14px;
    color: var(--text);
    font-family: 'DM Mono', monospace;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    outline: none;
    transition: border-color 0.2s;
  }
  input[type="text"]:focus {
    border-color: var(--green);
  }
  input[type="text"]::placeholder {
    color: var(--text-dim);
  }

  button {
    background: var(--green-dim);
    border: 1px solid var(--green);
    border-radius: 8px;
    padding: 12px 18px;
    color: var(--green);
    font-family: 'DM Mono', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  button:hover { background: rgba(61,220,110,0.2); }
  button:active { transform: scale(0.97); }

  .btn-camera {
    width: 100%;
    padding: 14px;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Result card */
  .result-card {
    border-radius: 12px;
    padding: 20px;
    border: 1px solid var(--border);
    background: var(--surface);
    display: none;
    animation: slideUp 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .result-card.halal {
    border-color: var(--green);
    background: var(--green-dim);
  }
  .result-card.haram {
    border-color: var(--red);
    background: var(--red-dim);
  }
  .result-card.uncertain {
    border-color: var(--amber);
    background: var(--amber-dim);
  }

  .result-status {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .status-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .status-label {
    font-family: 'Amiri', serif;
    font-size: 1.6rem;
    letter-spacing: 0.02em;
  }
  .halal .status-label { color: var(--green); }
  .haram .status-label { color: var(--red); }
  .uncertain .status-label { color: var(--amber); }

  .product-name {
    font-size: 0.9rem;
    color: var(--text);
    margin-bottom: 6px;
    line-height: 1.4;
  }

  .barcode-num {
    font-size: 0.65rem;
    color: var(--text-dim);
    letter-spacing: 0.1em;
    margin-bottom: 14px;
  }

  .divider {
    height: 1px;
    background: var(--border);
    margin: 14px 0;
  }

  .flags-title {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-dim);
    margin-bottom: 8px;
  }

  .flags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }

  .flag-tag {
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
  }
  .flag-haram { background: rgba(232,64,64,0.2); color: #ff8080; border: 1px solid rgba(232,64,64,0.3); }
  .flag-halal { background: rgba(61,220,110,0.15); color: var(--green); border: 1px solid rgba(61,220,110,0.3); }
  .flag-warn  { background: rgba(240,165,0,0.15); color: var(--amber); border: 1px solid rgba(240,165,0,0.3); }

  .cert-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.7rem;
    background: rgba(61,220,110,0.1);
    color: var(--green);
    border: 1px solid rgba(61,220,110,0.3);
    margin-top: 4px;
  }

  .ingredients-section {
    margin-top: 10px;
  }

  .ingredients-text {
    font-size: 0.68rem;
    color: var(--text-dim);
    line-height: 1.7;
    max-height: 80px;
    overflow-y: auto;
  }
  .ingredients-text .highlight-haram { color: #ff7070; font-weight: 500; }
  .ingredients-text .highlight-warn  { color: var(--amber); }

  /* Loader */
  .loader {
    display: none;
    text-align: center;
    padding: 24px;
    font-size: 0.7rem;
    color: var(--text-dim);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .loader-dots span {
    display: inline-block;
    animation: blink 1.2s infinite;
    margin: 0 1px;
  }
  .loader-dots span:nth-child(2) { animation-delay: 0.2s; }
  .loader-dots span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes blink {
    0%, 80%, 100% { opacity: 0.2; }
    40% { opacity: 1; }
  }

  .error-msg {
    display: none;
    padding: 14px;
    border-radius: 8px;
    background: rgba(232,64,64,0.1);
    border: 1px solid rgba(232,64,64,0.3);
    color: #ff8080;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  footer {
    width: 100%;
    max-width: 480px;
    padding: 20px 24px;
    text-align: center;
    font-size: 0.6rem;
    color: var(--text-dim);
    letter-spacing: 0.1em;
    line-height: 1.8;
  }
</style>
</head>
<body>

<header>
  <div class="logo-arabic">حلال</div>
  <div class="logo-sub">Halal Scanner</div>
</header>

<div class="main">

  <!-- Camera scanner -->
  <div class="scanner-wrap" id="scannerBox">
    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-bl"></div>
    <div class="corner corner-br"></div>
    <div class="scan-line" id="scanLine"></div>
    <div id="scanner-viewport"></div>
    <div class="scan-idle-text" id="idleText">Point camera at barcode</div>
  </div>

  <button class="btn-camera" id="cameraBtn" onclick="toggleCamera()">
    📷 &nbsp; START CAMERA SCAN
  </button>

  <!-- Manual input -->
  <div class="manual-section">
    <input type="text" id="barcodeInput" placeholder="Or enter barcode manually..." inputmode="numeric" maxlength="14">
    <button onclick="lookupManual()">CHECK</button>
  </div>

  <!-- Status -->
  <div class="loader" id="loader">
    Checking product<span class="loader-dots"><span>.</span><span>.</span><span>.</span></span>
  </div>
  <div class="error-msg" id="errorMsg"></div>

  <!-- Result -->
  <div class="result-card" id="resultCard">
    <div class="result-status">
      <div class="status-icon" id="statusIcon"></div>
      <div class="status-label" id="statusLabel"></div>
    </div>
    <div class="product-name" id="productName"></div>
    <div class="barcode-num" id="barcodeDisplay"></div>

    <div id="certSection" style="display:none">
      <div class="cert-badge">✓ Halal Certified</div>
    </div>

    <div class="divider"></div>

    <div id="flagsSection" style="display:none">
      <div class="flags-title">Detected Ingredients</div>
      <div class="flags-list" id="flagsList"></div>
    </div>

    <div class="ingredients-section" id="ingredientsSection" style="display:none">
      <div class="flags-title">Ingredients</div>
      <div class="ingredients-text" id="ingredientsText"></div>
    </div>
  </div>

</div>

<footer>
  Data: Open Food Facts · Ingredient analysis<br>
  ⚠️ Always verify with product packaging & certification authority
</footer>

<script>
// ─── HARAM & SUSPECT INGREDIENT DATABASE ────────────────────────────────────
const HARAM = [
  'pork','pig','swine','lard','gelatin','gelatine','bacon','ham','prosciutto',
  'pepperoni','salami','chorizo','pancetta','alcohol','wine','beer','rum','vodka',
  'whiskey','whisky','ethanol','ethyl alcohol','carmine','cochineal','e120',
  'rennet','pepsin','l-cysteine','e920','shellac','e904','isinglass',
  'blood','plasma','suet','tallow','dripping','e441','e542','e631','e635'
];

const WARN = [
  'whey','casein','lactose','mono and diglycerides','emulsifier','natural flavour',
  'natural flavor','natural flavoring','e471','e472','e476','e481','e482',
  'lecithin','vanilla extract','wine vinegar','malt vinegar','yeast extract',
  'enzymes','lipase','protease'
];

const HALAL_LABELS = [
  'halal','حلال','halaal','halal certified','muis','jakim','hfce','ifanca',
  'iswa','hfa','esma','hrs','iccv'
];

function analyzeIngredients(ingredients, labels) {
  if (!ingredients) ingredients = '';
  if (!labels) labels = '';
  const text = (ingredients + ' ' + labels).toLowerCase();

  const foundHaram = HARAM.filter(i => text.includes(i));
  const foundWarn  = WARN.filter(i => text.includes(i));
  const foundHalal = HALAL_LABELS.filter(l => text.includes(l));

  let status = 'uncertain';
  if (foundHaram.length > 0) status = 'haram';
  else if (foundHalal.length > 0) status = 'halal';
  else if (ingredients.length > 10) status = 'uncertain';

  return { status, foundHaram, foundWarn, foundHalal, hasCert: foundHalal.length > 0 };
}

function highlightIngredients(raw) {
  if (!raw) return '';
  let text = raw;
  HARAM.forEach(i => {
    const re = new RegExp(`(${i})`, 'gi');
    text = text.replace(re, '<span class="highlight-haram">$1</span>');
  });
  WARN.forEach(i => {
    const re = new RegExp(`(${i})`, 'gi');
    text = text.replace(re, '<span class="highlight-warn">$1</span>');
  });
  return text;
}

// ─── OPEN FOOD FACTS LOOKUP ─────────────────────────────────────────────────
async function lookupBarcode(barcode) {
  showLoader();
  hideResult();
  hideError();

  barcode = barcode.trim().replace(/\D/g, '');
  if (!barcode || barcode.length < 4) {
    showError('Please enter a valid barcode (at least 4 digits).');
    hideLoader();
    return;
  }

  try {
    const url = `https://world.openfoodfacts.org/api/v0/product/${barcode}.json`;
    const res = await fetch(url);
    const data = await res.json();

    if (data.status === 0 || !data.product) {
      // Product not found — do basic barcode heuristic
      showResult({
        name: 'Product not found in database',
        barcode,
        ingredients: '',
        labels: '',
        status: 'uncertain',
        foundHaram: [], foundWarn: [], foundHalal: [], hasCert: false,
        notFound: true
      });
      return;
    }

    const p = data.product;
    const ingredients = p.ingredients_text_en || p.ingredients_text || '';
    const labels = (p.labels || '') + ' ' + (p.labels_tags || []).join(' ');
    const name = p.product_name_en || p.product_name || 'Unknown product';

    const analysis = analyzeIngredients(ingredients, labels);

    showResult({
      name,
      barcode,
      ingredients,
      labels,
      ...analysis
    });

  } catch (e) {
    showError('Network error. Please check your connection and try again.');
  } finally {
    hideLoader();
  }
}

// ─── UI HELPERS ──────────────────────────────────────────────────────────────
function showLoader() {
  document.getElementById('loader').style.display = 'block';
}
function hideLoader() {
  document.getElementById('loader').style.display = 'none';
}
function hideResult() {
  document.getElementById('resultCard').style.display = 'none';
}
function hideError() {
  document.getElementById('errorMsg').style.display = 'none';
}
function showError(msg) {
  const el = document.getElementById('errorMsg');
  el.textContent = msg;
  el.style.display = 'block';
}

function showResult(r) {
  const card = document.getElementById('resultCard');
  card.className = 'result-card ' + r.status;

  const icons = { halal: '✅', haram: '❌', uncertain: '⚠️' };
  const labels = {
    halal: r.hasCert ? 'حلال — Halal' : 'Likely Halal',
    haram: 'حرام — Not Halal',
    uncertain: 'غير محدد — Uncertain'
  };

  document.getElementById('statusIcon').textContent = icons[r.status];
  document.getElementById('statusLabel').textContent = labels[r.status];
  document.getElementById('productName').textContent = r.name;
  document.getElementById('barcodeDisplay').textContent = 'Barcode: ' + r.barcode;

  // Cert badge
  const certSec = document.getElementById('certSection');
  certSec.style.display = r.hasCert ? 'block' : 'none';

  // Flags
  const flagsSec = document.getElementById('flagsSection');
  const flagsList = document.getElementById('flagsList');
  const allFlags = [
    ...r.foundHaram.map(f => ({ label: f, cls: 'flag-haram' })),
    ...r.foundWarn.map(f => ({ label: f, cls: 'flag-warn' })),
    ...r.foundHalal.map(f => ({ label: f, cls: 'flag-halal' })),
  ];

  if (allFlags.length > 0) {
    flagsList.innerHTML = allFlags.map(f =>
      `<span class="flag-tag ${f.cls}">${f.label}</span>`
    ).join('');
    flagsSec.style.display = 'block';
  } else {
    flagsSec.style.display = 'none';
  }

  // Ingredients
  const ingSection = document.getElementById('ingredientsSection');
  if (r.ingredients) {
    document.getElementById('ingredientsText').innerHTML =
      highlightIngredients(r.ingredients.substring(0, 500)) +
      (r.ingredients.length > 500 ? '...' : '');
    ingSection.style.display = 'block';
  } else {
    ingSection.style.display = 'none';
  }

  card.style.display = 'block';
}

function lookupManual() {
  const val = document.getElementById('barcodeInput').value;
  lookupBarcode(val);
}

document.getElementById('barcodeInput').addEventListener('keydown', e => {
  if (e.key === 'Enter') lookupManual();
});

// ─── QUAGGA CAMERA SCANNER ───────────────────────────────────────────────────
let cameraActive = false;
let lastScanned = '';
let scanCooldown = false;

function toggleCamera() {
  if (cameraActive) stopCamera();
  else startCamera();
}

function startCamera() {
  const btn = document.getElementById('cameraBtn');
  btn.textContent = '⏹  STOP CAMERA';
  document.getElementById('idleText').style.display = 'none';

  Quagga.init({
    inputStream: {
      name: 'Live',
      type: 'LiveStream',
      target: document.getElementById('scanner-viewport'),
      constraints: {
        facingMode: 'environment',
        width: { ideal: 640 },
        height: { ideal: 640 }
      }
    },
    decoder: {
      readers: ['ean_reader','ean_8_reader','upc_reader','upc_e_reader','code_128_reader','code_39_reader']
    },
    locate: true,
    locator: {
      patchSize: 'medium',
      halfSample: true
    }
  }, function(err) {
    if (err) {
      showError('Camera access denied or not available. Please use manual entry.');
      resetCameraBtn();
      return;
    }
    Quagga.start();
    cameraActive = true;
  });

  Quagga.onDetected(function(result) {
    const code = result.codeResult.code;
    if (!code || scanCooldown || code === lastScanned) return;

    lastScanned = code;
    scanCooldown = true;
    setTimeout(() => { scanCooldown = false; }, 3000);

    // Flash effect
    document.getElementById('scannerBox').style.boxShadow = '0 0 0 3px var(--green)';
    setTimeout(() => { document.getElementById('scannerBox').style.boxShadow = ''; }, 400);

    document.getElementById('barcodeInput').value = code;
    lookupBarcode(code);
  });
}

function stopCamera() {
  Quagga.stop();
  cameraActive = false;
  resetCameraBtn();
  document.getElementById('idleText').style.display = 'flex';
}

function resetCameraBtn() {
  document.getElementById('cameraBtn').textContent = '📷  START CAMERA SCAN';
  cameraActive = false;
}
</script>
</body>
</html>
